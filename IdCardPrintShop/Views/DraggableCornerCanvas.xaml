<UserControl x:Class="IdCardPrintShop.Views.DraggableCornerCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="700"
             ClipToBounds="True"
             Background="#1a1c23">
    <Grid x:Name="RootGrid" SizeChanged="OnRootGridSizeChanged">
        <Canvas x:Name="OverlayCanvas"
                MouseDown="OnCanvasMouseDown"
                MouseMove="OnCanvasMouseMove"
                MouseUp="OnCanvasMouseUp"
                MouseLeave="OnCanvasMouseLeave"
                Background="Transparent"
                Cursor="Cross">
            
            <!-- Background Image -->
            <Image x:Name="DisplayImage"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Connecting Quad Polygon -->
            <Polygon x:Name="QuadPolygon"
                     Stroke="#00E5FF"
                     StrokeThickness="2.5"
                     Fill="#3300E5FF"
                     StrokeDashArray="4 2" />

            <!-- Corner 0 (Top-Left) -->
            <Grid x:Name="Handle0" Width="28" Height="28" Cursor="Hand">
                <Ellipse Fill="#00E676" Stroke="#FFFFFF" StrokeThickness="2.5" />
                <TextBlock Text="1" Foreground="#000000" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- Corner 1 (Top-Right) -->
            <Grid x:Name="Handle1" Width="28" Height="28" Cursor="Hand">
                <Ellipse Fill="#FFD600" Stroke="#FFFFFF" StrokeThickness="2.5" />
                <TextBlock Text="2" Foreground="#000000" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- Corner 2 (Bottom-Right) -->
            <Grid x:Name="Handle2" Width="28" Height="28" Cursor="Hand">
                <Ellipse Fill="#FF1744" Stroke="#FFFFFF" StrokeThickness="2.5" />
                <TextBlock Text="3" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- Corner 3 (Bottom-Left) -->
            <Grid x:Name="Handle3" Width="28" Height="28" Cursor="Hand">
                <Ellipse Fill="#2979FF" Stroke="#FFFFFF" StrokeThickness="2.5" />
                <TextBlock Text="4" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Canvas>
    </Grid>
</UserControl>
