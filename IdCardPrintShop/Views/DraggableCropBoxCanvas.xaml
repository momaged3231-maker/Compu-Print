<UserControl x:Class="IdCardPrintShop.Views.DraggableCropBoxCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="600"
             ClipToBounds="True"
             Background="#141720">
    <Grid x:Name="RootGrid" SizeChanged="OnRootGridSizeChanged">
        <Canvas x:Name="OverlayCanvas"
                MouseDown="OnCanvasMouseDown"
                MouseMove="OnCanvasMouseMove"
                MouseUp="OnCanvasMouseUp"
                MouseLeave="OnCanvasMouseLeave"
                Background="Transparent">

            <!-- Background Source Image -->
            <Image x:Name="DisplayImage"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Shaded Dim Overlay (Outer area) -->
            <Path x:Name="DimPath" Fill="#88000000" />

            <!-- Active Crop Box Border -->
            <Rectangle x:Name="CropRectVisual"
                       Stroke="#00E5FF"
                       StrokeThickness="2"
                       Fill="#1500E5FF"
                       Cursor="SizeAll" />

            <!-- Rule of Thirds Guide Lines -->
            <Line x:Name="LineH1" Stroke="#5500E5FF" StrokeThickness="1" StrokeDashArray="3 3" />
            <Line x:Name="LineH2" Stroke="#5500E5FF" StrokeThickness="1" StrokeDashArray="3 3" />
            <Line x:Name="LineV1" Stroke="#5500E5FF" StrokeThickness="1" StrokeDashArray="3 3" />
            <Line x:Name="LineV2" Stroke="#5500E5FF" StrokeThickness="1" StrokeDashArray="3 3" />

            <!-- 4 Corner Resizing Handles -->
            <Thumb x:Name="ThumbTL" Width="18" Height="18" Margin="-9" Cursor="SizeNWSE" />
            <Thumb x:Name="ThumbTR" Width="18" Height="18" Margin="-9" Cursor="SizeNESW" />
            <Thumb x:Name="ThumbBR" Width="18" Height="18" Margin="-9" Cursor="SizeNWSE" />
            <Thumb x:Name="ThumbBL" Width="18" Height="18" Margin="-9" Cursor="SizeNESW" />
        </Canvas>
    </Grid>
</UserControl>
