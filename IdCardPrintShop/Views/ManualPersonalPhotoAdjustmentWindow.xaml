<Window x:Class="IdCardPrintShop.Views.ManualPersonalPhotoAdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:IdCardPrintShop.Views"
        xmlns:models="clr-namespace:IdCardPrintShop.Models"
        mc:Ignorable="d"
        Title="تعديل وضبط الصورة الشخصية (Studio Photo Adjustments)"
        Height="800" Width="1120"
        WindowStartupLocation="CenterOwner"
        Background="#10131a"
        Foreground="#f0f2f5"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1f2533" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#353e52" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2c3547" />
                    <Setter Property="BorderBrush" Value="#00E5FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Top Guidance Banner -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Banner -->
        <Border Grid.Row="0" Background="#181d28" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" BorderBrush="#273145" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="👤 ضبط وتحسين الصورة الشخصية وموضع الرأس" FontSize="16" FontWeight="Bold" Foreground="#00E5FF" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#8592a6" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Interactive Canvas with Draggable Crop Frame -->
                <ColumnDefinition Width="1.8*" />
                <!-- Right: Controls & Live Studio Preview -->
                <ColumnDefinition Width="1*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Interactive Crop Canvas -->
            <Border Grid.Column="0" Background="#0b0d13" CornerRadius="8" BorderBrush="#222838" BorderThickness="1" Margin="0,0,12,0">
                <views:DraggableCropBoxCanvas x:Name="CropCanvas" />
            </Border>

            <!-- Right Controls Panel -->
            <Border Grid.Column="1" Background="#161a24" CornerRadius="8" BorderBrush="#222838" BorderThickness="1" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        
                        <!-- Live Studio Result Preview -->
                        <TextBlock Text="معاينة الصورة الناتجة للطباعة:" FontWeight="Bold" FontSize="13" Foreground="#c5d0e0" Margin="0,0,0,6" />
                        <Border Background="#FFFFFF" CornerRadius="6" BorderBrush="#343d52" BorderThickness="1" Height="220" Margin="0,0,0,12" ClipToBounds="True">
                            <Image Source="{Binding LivePreview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <!-- Background Options -->
                        <TextBlock Text="لون ونوع الخلفية:" FontWeight="Bold" FontSize="13" Foreground="#c5d0e0" Margin="0,0,0,6" />
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button Command="{Binding SetBackgroundTypeCommand}" CommandParameter="{x:Static models:PhotoBackgroundType.PureWhite}" Content="⚪ بيضاء نقية" Margin="2" />
                            <Button Command="{Binding SetBackgroundTypeCommand}" CommandParameter="{x:Static models:PhotoBackgroundType.LightBlue}" Content="🔵 زرقاء فاتحة" Margin="2" />
                            <Button Command="{Binding SetBackgroundTypeCommand}" CommandParameter="{x:Static models:PhotoBackgroundType.LightGray}" Content="🔘 رمادية فاتحة" Margin="2" />
                            <Button Command="{Binding SetBackgroundTypeCommand}" CommandParameter="{x:Static models:PhotoBackgroundType.Original}" Content="📷 الخلفية الأصلية" Margin="2" />
                        </UniformGrid>

                        <!-- Edge Feather Slider -->
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="نعومة حواف الشعر والكتف:" FontSize="12" Foreground="#8592a6" />
                            <TextBlock Grid.Column="1" Text="{Binding EdgeFeatherRadius, StringFormat='{}{0:F1} px'}" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" />
                        </Grid>
                        <Slider Minimum="0.5" Maximum="5" Value="{Binding EdgeFeatherRadius}" />

                        <!-- Color & Light Adjustments -->
                        <TextBlock Text="ضبط الإضاءة والألوان:" FontWeight="Bold" FontSize="13" Foreground="#c5d0e0" Margin="0,8,0,6" />
                        
                        <!-- Brightness -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الإضاءة (Brightness):" FontSize="11" Foreground="#8592a6" />
                            <TextBlock Grid.Column="1" Text="{Binding Brightness, StringFormat='{}{0:F0}'}" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" />
                        </Grid>
                        <Slider Minimum="-40" Maximum="40" Value="{Binding Brightness}" />

                        <!-- Contrast -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="التباين (Contrast):" FontSize="11" Foreground="#8592a6" />
                            <TextBlock Grid.Column="1" Text="{Binding Contrast, StringFormat='{}{0:F0}'}" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" />
                        </Grid>
                        <Slider Minimum="-40" Maximum="40" Value="{Binding Contrast}" />

                        <!-- Saturation -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="تشبع الألوان (Saturation):" FontSize="11" Foreground="#8592a6" />
                            <TextBlock Grid.Column="1" Text="{Binding Saturation, StringFormat='{}{0:F0}'}" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" />
                        </Grid>
                        <Slider Minimum="-40" Maximum="40" Value="{Binding Saturation}" />

                        <!-- Temperature -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="حرارة اللون (Cool / Warm):" FontSize="11" Foreground="#8592a6" />
                            <TextBlock Grid.Column="1" Text="{Binding Temperature, StringFormat='{}{0:F0}'}" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" />
                        </Grid>
                        <Slider Minimum="-25" Maximum="25" Value="{Binding Temperature}" />

                        <!-- Fast Rotation & Reset -->
                        <TextBlock Text="التدوير وإعادة الضبط:" FontWeight="Bold" FontSize="13" Foreground="#c5d0e0" Margin="0,8,0,6" />
                        <UniformGrid Columns="3" Margin="0,0,0,6">
                            <Button Command="{Binding Rotate90CWCommand}" Content="🔄 90° يمين" Margin="2" />
                            <Button Command="{Binding Rotate90CCWCommand}" Content="🔄 90° يسار" Margin="2" />
                            <Button Command="{Binding ResetSettingsCommand}" Content="↩️ استعادة" Margin="2" />
                        </UniformGrid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Footer -->
        <Border Grid.Row="2" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💡 نصيحة: اسحب المربع الأزرق لتحريك إطار الصورة، ويتم الحفاظ تلقائياً على نسبة الأبعاد القياسية." Foreground="#6e7b8f" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding CancelCommand}" Content="إلغاء التعديل" Width="120" Margin="6,0" />
                    <Button Command="{Binding ApplyCommand}" Content="✅ تطبيق وحفظ الصورة" Width="170" Margin="6,0"
                            Background="#00b0ff" BorderBrush="#0091ea" Foreground="#FFFFFF" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
